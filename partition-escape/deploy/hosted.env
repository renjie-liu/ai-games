# Where a hosted server finds its parts. Read by entrypoint.sh, which starts the server, and by
# run.sh, which runs the operator's commands, so that both see the same.
export PARTITION_HARNESS_ROOT=/app/harness
export PARTITION_PYTHON=/app/harness/.venv/bin/python
# Both are written to the volume at the first start, from the files beside this one, and are the
# operator's to edit from then on (restart to apply).
export PARTITION_HOSTING=/data/hosting.json
export PARTITION_LIVE_LIMITS=/data/limits.json
export PORT=8080
