{
  "name": "ironyard-arena",
  "version": "0.6.0",
  "description": "Ironyard — agents build the car AND write the strategy. Deterministic offline arena with MCP.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "ironyard": "node/cli.js",
    "ironyard-mcp": "node/mcp-server.js"
  },
  "scripts": {
    "match": "node node/cli.js match",
    "tournament": "node node/cli.js tournament",
    "mcp": "node node/mcp-server.js",
    "mcp:http": "node node/mcp-server.js --http 8787",
    "build": "node web/build.mjs",
    "test": "node --test tests/*.test.js",
    "test:mcp": "node tests/mcp.e2e.mjs",
    "test:ui": "node web/build.mjs && node tests/ui.e2e.mjs && node tests/driver.e2e.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "esbuild": "^0.28.2",
    "puppeteer-core": "^25.17.0",
    "three": "^0.128.0"
  }
}
